# Copy to .env on the server:  cp deploy.env.example .env
#
# The address the site is served on. Caddy gets a free HTTPS certificate for
# it automatically. Either your own domain (with a DNS A record pointing at the
# server), or, with no domain, the server's IP with dots replaced by dashes
# plus .sslip.io, e.g. 203.0.113.5 -> 203-0-113-5.sslip.io
SITE_ADDRESS=203-0-113-5.sslip.io

# Only when the frontend is hosted on Vercel: the Vercel address(es) allowed to
# call this API, comma-separated, no trailing slash.
# APEX_CORS_ORIGINS=https://your-app.vercel.app
